<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RifaCasa.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MercadoPago" Version="1.0.4477.31589" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RifaCasa.Controllers\RifaCasa.Controllers.csproj" />
    <ProjectReference Include="..\RifaCasa.Data\RifaCasa.Data.csproj" />
    <ProjectReference Include="..\RifaCasa.Services\RifaCasa.Services.csproj" />
  </ItemGroup>

  <!-- Esta parte garante que arquivos da wwwroot sejam publicados -->
  <ItemGroup>
    <Content Update="wwwroot\**\*">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
