<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RifaCasa.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Views\NovaPasta\**" />
    <Content Remove="Views\NovaPasta\**" />
    <EmbeddedResource Remove="Views\NovaPasta\**" />
    <None Remove="Views\NovaPasta\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RifaCasa.Controllers\RifaCasa.Controllers.csproj" />
    <ProjectReference Include="..\RifaCasa.Data\RifaCasa.Data.csproj" />
    <ProjectReference Include="..\RifaCasa.Services\RifaCasa.Services.csproj" />
  </ItemGroup>

  <!-- Esta parte garante que arquivos da wwwroot sejam publicados -->
  <ItemGroup>
    <Content Update="wwwroot\**\*">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
